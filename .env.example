# Polymarket Auto-Trading Configuration
# Copy this to .env and fill in your values

# Your Polygon wallet private key (with 0x prefix)
# This wallet must:
#   1. Be funded with USDC on Polygon network
#   2. Have approved the Polymarket CTF Exchange contract
# Get setup: https://docs.polymarket.com
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Safety limits (defaults shown, override if needed)
# MAX_BANKROLL=20.0
# MAX_ORDER_SIZE=2.0
# MAX_DAILY_LOSS=5.0
